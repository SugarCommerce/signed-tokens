{
  "name": "sugarcommerce/signed-tokens",
  "version": "1.0.0",
  "description": "HMAC-signed, expiring, namespaced tokens for URLs. Magic sign-in links, password resets, download URLs and unsubscribe links with no database row. Zero dependencies, supports secret rotation.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/signed-tokens",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "token",
    "hmac",
    "magic-link",
    "passwordless",
    "signed-url",
    "jwt-alternative",
    "expiring",
    "authentication"
  ],
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "SugarCommerce\\SignedTokens\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarCommerce\\SignedTokens\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "bench": "php -d opcache.enable_cli=1 -d opcache.jit=tracing -d opcache.jit_buffer_size=64M bench/run.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarcommerce/signed-tokens/issues",
    "source": "https://github.com/sugarcommerce/signed-tokens"
  }
}
